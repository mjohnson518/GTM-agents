// GTM-agents: Worker configuration template.
//
// Resource ids and names are ${...} placeholders. The Worker and bucket names use the defaults
// gtm-agent and gtm-agent-bucket instead, because Wrangler validates their format even in a dry
// run. `gtm setup` creates the resources and fills in your deployment's copy; keep this file free
// of real ids. `wrangler deploy` deploys production (the top level); `wrangler deploy --env staging`
// deploys staging, which has its own resources. Wrangler does not inherit bindings into
// environments, so staging repeats them. There is exactly one cron trigger, every minute: the
// scheduled handler runs each registered job whose own schedule matches that minute (UTC), so a new
// job never needs a new trigger. Keep it the only one; an extra trigger runs the jobs due in its
// minutes a second time, and `gtm doctor` fails on it. With the JOBS_QUEUE producer and its
// consumer, and the scheduler:queue_enabled flag on (it is off by default), the scheduled handler
// sends each due job to the queue and the consumer runs one job per
// invocation (max_batch_size 1), each with its own 15-minute wall time; remove all three JOBS lines
// to run due jobs inside the cron invocation instead. max_concurrency 8 runs a busy minute's jobs
// side by side, twice the in-process bound, without opening more D1 and provider connections than a
// deployment's jobs need; one retry covers a claim that could not be written, and what still fails
// lands on the dead-letter queue, whose consumer records it and pages once a day.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gtm-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },

  "build": { "command": "npm run build --workspace @gtm-agents/admin", "cwd": "../.." },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },

  "vars": { "AGENT_BASE_URL": "${AGENT_BASE_URL}", "ENVIRONMENT": "production" },

  "d1_databases": [
    { "binding": "DB", "database_name": "${DB_NAME}", "database_id": "${DB_ID}", "migrations_dir": "../../packages/core/migrations" }
  ],
  "kv_namespaces": [{ "binding": "KV", "id": "${KV_ID}" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "gtm-agent-bucket" }],
  "vectorize": [{ "binding": "MEMORY", "index_name": "${VECTOR_INDEX_NAME}" }],
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      { "name": "GATEWAY", "class_name": "OperatorGateway" },
      { "name": "FOLLOWUP_AGENT", "class_name": "FollowupAgent" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OperatorGateway", "FollowupAgent"] }],
  "queues": {
    "producers": [
      { "binding": "EVENTS_QUEUE", "queue": "${EVENTS_QUEUE_NAME}" },
      { "binding": "CHAT_QUEUE", "queue": "${CHAT_QUEUE_NAME}" },
      { "binding": "JOBS_QUEUE", "queue": "${JOBS_QUEUE_NAME}" }
    ],
    "consumers": [
      { "queue": "${EVENTS_QUEUE_NAME}", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 5, "dead_letter_queue": "${EVENTS_DLQ_NAME}" },
      { "queue": "${CHAT_QUEUE_NAME}", "max_batch_size": 1, "max_batch_timeout": 0, "max_concurrency": 1, "max_retries": 0 },
      { "queue": "${JOBS_QUEUE_NAME}", "max_batch_size": 1, "max_batch_timeout": 0, "max_concurrency": 8, "max_retries": 1, "retry_delay": 30, "dead_letter_queue": "${JOBS_DLQ_NAME}" },
      { "queue": "${JOBS_DLQ_NAME}", "max_batch_size": 10, "max_batch_timeout": 30, "max_concurrency": 1, "max_retries": 0 }
    ]
  },
  "triggers": { "crons": ["* * * * *"] },

  "env": {
    "staging": {
      "name": "gtm-agent-staging",
      "vars": { "AGENT_BASE_URL": "${STAGING_AGENT_BASE_URL}", "ENVIRONMENT": "staging" },
      "d1_databases": [
        { "binding": "DB", "database_name": "${STAGING_DB_NAME}", "database_id": "${STAGING_DB_ID}", "migrations_dir": "../../packages/core/migrations" }
      ],
      "kv_namespaces": [{ "binding": "KV", "id": "${STAGING_KV_ID}" }],
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "gtm-agent-staging-bucket" }],
      "vectorize": [{ "binding": "MEMORY", "index_name": "${STAGING_VECTOR_INDEX_NAME}" }],
      "ai": { "binding": "AI" },
      "durable_objects": {
        "bindings": [
          { "name": "GATEWAY", "class_name": "OperatorGateway" },
          { "name": "FOLLOWUP_AGENT", "class_name": "FollowupAgent" }
        ]
      },
      "queues": {
        "producers": [
          { "binding": "EVENTS_QUEUE", "queue": "${STAGING_EVENTS_QUEUE_NAME}" },
          { "binding": "CHAT_QUEUE", "queue": "${STAGING_CHAT_QUEUE_NAME}" },
          { "binding": "JOBS_QUEUE", "queue": "${STAGING_JOBS_QUEUE_NAME}" }
        ],
        "consumers": [
          { "queue": "${STAGING_EVENTS_QUEUE_NAME}", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 5, "dead_letter_queue": "${STAGING_EVENTS_DLQ_NAME}" },
          { "queue": "${STAGING_CHAT_QUEUE_NAME}", "max_batch_size": 1, "max_batch_timeout": 0, "max_concurrency": 1, "max_retries": 0 },
          { "queue": "${STAGING_JOBS_QUEUE_NAME}", "max_batch_size": 1, "max_batch_timeout": 0, "max_concurrency": 8, "max_retries": 1, "retry_delay": 30, "dead_letter_queue": "${STAGING_JOBS_DLQ_NAME}" },
          { "queue": "${STAGING_JOBS_DLQ_NAME}", "max_batch_size": 10, "max_batch_timeout": 30, "max_concurrency": 1, "max_retries": 0 }
        ]
      },
      "triggers": { "crons": ["* * * * *"] }
    }
  }
}
