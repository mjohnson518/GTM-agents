{
  "title": "GTM-agents brain item: signals",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "job_change",
        "hiring",
        "funding",
        "launch",
        "post",
        "news",
        "filing",
        "product_usage",
        "custom"
      ]
    },
    "weight": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "max_age_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 365
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    }
  },
  "required": [
    "type",
    "weight",
    "text"
  ],
  "additionalProperties": false
}
