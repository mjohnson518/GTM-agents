{
  "title": "GTM-agents brain item: keyword-portfolio",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "intent": {
      "type": "string",
      "enum": [
        "problem",
        "solution",
        "competitor",
        "trigger",
        "role"
      ]
    },
    "segment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    }
  },
  "required": [
    "query",
    "intent"
  ],
  "additionalProperties": false
}
