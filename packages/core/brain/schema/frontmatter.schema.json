{
  "title": "GTM-agents brain file frontmatter",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "component": {
      "type": "string",
      "enum": [
        "market-profile",
        "personas",
        "icp",
        "message-pillars",
        "objections",
        "competitors",
        "influencers",
        "keyword-portfolio",
        "voice",
        "signals",
        "stack",
        "hiring",
        "facts",
        "commercial"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    }
  },
  "required": [
    "component",
    "status",
    "version",
    "updated"
  ],
  "additionalProperties": false
}
