{
  "name": "@gtm-agents/adapters",
  "version": "0.0.0",
  "private": true,
  "description": "Vendor integrations for GTM-agents, one folder per adapter behind a port, exported as subpaths.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./_contract/*": "./_contract/*",
    "./data-exa": "./data-exa/index.ts",
    "./data-exa/manifest.json": "./data-exa/manifest.json",
    "./data-jobboards": "./data-jobboards/index.ts",
    "./data-jobboards/manifest.json": "./data-jobboards/manifest.json",
    "./data-hunter": "./data-hunter/index.ts",
    "./data-hunter/manifest.json": "./data-hunter/manifest.json",
    "./operator-telegram": "./operator-telegram/index.ts",
    "./operator-telegram/manifest.json": "./operator-telegram/manifest.json",
    "./llm-gateway": "./llm-gateway/index.ts",
    "./llm-gateway/manifest.json": "./llm-gateway/manifest.json",
    "./email-resend": "./email-resend/index.ts",
    "./email-resend/manifest.json": "./email-resend/manifest.json",
    "./_google-auth": "./_google-auth/index.ts",
    "./inbox-gmail": "./inbox-gmail/index.ts",
    "./inbox-gmail/manifest.json": "./inbox-gmail/manifest.json",
    "./email-cloudflare": "./email-cloudflare/index.ts",
    "./email-cloudflare/manifest.json": "./email-cloudflare/manifest.json",
    "./calendar-google": "./calendar-google/index.ts",
    "./calendar-google/manifest.json": "./calendar-google/manifest.json",
    "./billing-stripe": "./billing-stripe/index.ts",
    "./billing-stripe/manifest.json": "./billing-stripe/manifest.json",
    "./code-github": "./code-github/index.ts",
    "./code-github/manifest.json": "./code-github/manifest.json",
    "./sandbox-cloudflare": "./sandbox-cloudflare/index.ts",
    "./sandbox-cloudflare/manifest.json": "./sandbox-cloudflare/manifest.json",
    "./sandbox-cloudflare/images/*": "./sandbox-cloudflare/images/*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@cloudflare/sandbox": "1.0.3",
    "@gtm-agents/core": "0.0.0",
    "postal-mime": "4.1.4"
  }
}
